---
import { render, type CollectionEntry } from "astro:content";
import type { BlogLocale } from "../../lib/blog";
import {
  BLOG_COPY,
  BLOG_LANGUAGE_LABELS,
  formatBlogDate,
  getBlogIndexPath,
  getBlogPostPath
} from "../../lib/blog";

interface Props {
  locale: BlogLocale;
  post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props;
const copy = BLOG_COPY[locale];
const { Content } = await render(post);
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        --bg: #f8f6f1;
        --text: #14202e;
        --muted: rgba(20, 32, 46, 0.66);
        --line: rgba(20, 32, 46, 0.1);
        --quote: rgba(44, 86, 122, 0.08);
        --font-ui: "Iowan Old Style", "Georgia", "PingFang SC", serif;
        --font-sans: "Avenir Next", "Trebuchet MS", "PingFang SC", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: linear-gradient(180deg, #fcfbf7, var(--bg));
        color: var(--text);
      }

      body {
        padding: 24px;
        font-family: var(--font-ui);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        max-width: 760px;
        margin: 0 auto;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 0 34px;
        border-bottom: 1px solid var(--line);
        font-family: var(--font-sans);
      }

      .topbar__nav {
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--muted);
      }

      .meta {
        margin-top: 56px;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 0.92rem;
      }

      h1 {
        margin: 18px 0 0;
        font-size: clamp(2.6rem, 5vw, 4.6rem);
        line-height: 0.95;
        font-weight: 600;
      }

      .content {
        margin-top: 26px;
      }

      .content :global(p) {
        margin: 0 0 16px;
        color: rgba(20, 32, 46, 0.88);
        line-height: 2;
        font-size: 1.06rem;
      }

      .content :global(blockquote) {
        margin: 34px 0 10px;
        padding: 20px 22px;
        border-left: 3px solid #2c567a;
        background: var(--quote);
        font-size: 1.08rem;
        line-height: 1.8;
      }

      .content :global(h2) {
        padding: 34px 0 0;
        margin: 0 0 16px;
        font-size: 1.7rem;
        font-weight: 600;
      }

      .locale-switch {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px;
        border-radius: 999px;
        background: rgba(20, 32, 46, 0.05);
        border: 1px solid var(--line);
      }

      .locale-switch a {
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.86rem;
        color: var(--muted);
      }

      .locale-switch a.is-active {
        background: #14202e;
        color: white;
      }

      .footer {
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-family: var(--font-sans);
      }

      @media (max-width: 720px) {
        body {
          padding: 18px;
        }

        .topbar {
          align-items: start;
          flex-direction: column;
        }

        .topbar__nav {
          flex-wrap: wrap;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="topbar">
        <div class="topbar__nav">
          <a href={getBlogIndexPath(locale)}>{copy.backToBlog}</a>
          <a href="/">Home</a>
        </div>
        <div class="locale-switch" aria-label="Language switch">
          <a
            class={locale === "zh" ? "is-active" : ""}
            data-blog-locale-switch="zh"
            href={getBlogPostPath("zh", post.data.translationKey)}
          >
            {BLOG_LANGUAGE_LABELS.zh}
          </a>
          <a
            class={locale === "en" ? "is-active" : ""}
            data-blog-locale-switch="en"
            href={getBlogPostPath("en", post.data.translationKey)}
          >
            {BLOG_LANGUAGE_LABELS.en}
          </a>
        </div>
      </header>

      <div class="meta">
        <span>{formatBlogDate(post.data.date)}</span>
        <span> · </span>
        <span>{post.data.readTime}</span>
      </div>

      <h1>{post.data.title}</h1>
      <article class="content">
        <Content />
      </article>

      <footer class="footer">
        <a href={getBlogIndexPath(locale)}>{copy.moreArticles}</a>
      </footer>
    </main>

    <script is:inline define:vars={{ locale }}>
      localStorage.setItem("blog-locale", locale);
      document.querySelectorAll("[data-blog-locale-switch]").forEach((link) => {
        link.addEventListener("click", () => {
          localStorage.setItem("blog-locale", link.getAttribute("data-blog-locale-switch") || locale);
        });
      });
    </script>
  </body>
</html>
