---
import { render, type CollectionEntry } from "astro:content";
import type { BlogLocale } from "../../lib/blog";
import {
  BLOG_COPY,
  BLOG_LANGUAGE_LABELS,
  formatBlogDate,
  getBlogIndexPath,
  getBlogPostPath
} from "../../lib/blog";

interface Props {
  locale: BlogLocale;
  post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props;
const copy = BLOG_COPY[locale];
const { Content } = await render(post);
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style>
      :root {
        --bg: #0f0f12;
        --fg: #F5F0EB;
        --secondary: rgba(245, 240, 235, 0.55);
        --dim: rgba(245, 240, 235, 0.28);
        --border: rgba(255, 255, 255, 0.06);
        --accent: #FF6B3D;
        --accent-soft: rgba(255, 107, 61, 0.1);
        --font-display: "Iowan Old Style", "Baskerville", "Palatino Linotype", "Noto Serif SC", "Songti SC", "STSong", serif;
        --font-ui: "Avenir Next", "SF Pro Text", "Segoe UI", "PingFang SC", sans-serif;
        --font-mono: "SF Mono", "JetBrains Mono", "Menlo", monospace;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
      }

      body { padding: 28px; font-family: var(--font-display); font-size: 16px; }

      a { color: inherit; text-decoration: none; }

      .page { max-width: 640px; margin: 0 auto; }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 0 24px;
        border-bottom: 1px solid var(--border);
        font-family: var(--font-ui);
      }

      .topbar__nav {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--dim);
        font-size: 11px;
        letter-spacing: 0.03em;
      }

      .topbar__nav a:hover { color: var(--fg); }

      .meta {
        margin-top: 48px;
        display: flex;
        gap: 8px;
        color: var(--dim);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      h1 {
        margin: 12px 0 0;
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 4vw, 3rem);
        line-height: 1.08;
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--fg);
      }

      .content {
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
      }

      .content :global(p) {
        margin: 0 0 20px;
        color: rgba(245, 240, 235, 0.72);
        line-height: 1.9;
        font-size: 16px;
        font-weight: 300;
      }

      .content :global(blockquote) {
        margin: 20px 0 20px;
        padding: 14px 18px;
        border-left: 2px solid var(--accent);
        background: var(--accent-soft);
        border-radius: 0 6px 6px 0;
        font-size: 15px;
        font-style: italic;
        line-height: 1.75;
        color: var(--accent);
      }

      .content :global(h2) {
        padding: 28px 0 0;
        margin: 0 0 14px;
        font-size: 1.4rem;
        font-weight: 600;
        font-family: var(--font-display);
        letter-spacing: -0.02em;
        color: var(--fg);
      }

      .content :global(code) {
        font-family: var(--font-mono);
        font-size: 0.82em;
        padding: 2px 6px;
        border-radius: 4px;
        background: rgba(255,255,255,0.05);
        color: rgba(245,240,235,0.75);
      }

      .locale-switch {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border);
      }

      .locale-switch a {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 500;
        color: var(--dim);
        transition: all 0.12s;
      }

      .locale-switch a.is-active {
        background: var(--accent);
        color: white;
      }

      .footer {
        margin-top: 48px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        color: var(--dim);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.04em;
      }

      .footer a { color: var(--accent); }
      .footer a:hover { opacity: 0.8; }

      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 10px; }

      @media (max-width: 720px) {
        body { padding: 18px; }
        .topbar { align-items: start; flex-direction: column; }
        .topbar__nav { flex-wrap: wrap; }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="topbar">
        <div class="topbar__nav">
          <a href={getBlogIndexPath(locale)}>{copy.backToBlog}</a>
          <a href="/">Home</a>
        </div>
        <div class="locale-switch" aria-label="Language switch">
          <a
            class={locale === "zh" ? "is-active" : ""}
            data-blog-locale-switch="zh"
            href={getBlogPostPath("zh", post.data.translationKey)}
          >
            {BLOG_LANGUAGE_LABELS.zh}
          </a>
          <a
            class={locale === "en" ? "is-active" : ""}
            data-blog-locale-switch="en"
            href={getBlogPostPath("en", post.data.translationKey)}
          >
            {BLOG_LANGUAGE_LABELS.en}
          </a>
        </div>
      </header>

      <div class="meta">
        <span>{formatBlogDate(post.data.date)}</span>
        <span> · </span>
        <span>{post.data.readTime}</span>
      </div>

      <h1>{post.data.title}</h1>
      <article class="content">
        <Content />
      </article>

      <footer class="footer">
        <a href={getBlogIndexPath(locale)}>{copy.moreArticles}</a>
      </footer>
    </main>

    <script is:inline define:vars={{ locale }}>
      localStorage.setItem("blog-locale", locale);
      document.querySelectorAll("[data-blog-locale-switch]").forEach((link) => {
        link.addEventListener("click", () => {
          localStorage.setItem("blog-locale", link.getAttribute("data-blog-locale-switch") || locale);
        });
      });
    </script>
  </body>
</html>
