---
import { render, type CollectionEntry } from "astro:content";
import SystemBreadcrumbs from "../shared/SystemBreadcrumbs.astro";
import type { BlogLocale } from "../../lib/blog";
import {
  BLOG_COPY,
  BLOG_LANGUAGE_LABELS,
  BLOG_LANGUAGE_SWITCH_LABELS,
  formatBlogDate,
  getBlogIndexPath,
  getBlogPostPath
} from "../../lib/blog";

interface Props {
  locale: BlogLocale;
  post: CollectionEntry<"blog">;
  fallbackLocale?: BlogLocale | null;
}

const { locale, post, fallbackLocale = null } = Astro.props;
const copy = BLOG_COPY[locale];
const { Content } = await render(post);
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{post.data.title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/styles/desktop-os.css" />
    <style>
      :root {
        --secondary: #4f4a42;
        --dim: #867e71;
        --border: rgba(24, 24, 24, 0.06);
        --accent: #181818;
        --accent-soft: rgba(24, 24, 24, 0.04);
        --font-display: "SF Pro Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
        --font-ui: Inter, -apple-system, "PingFang SC", sans-serif;
        --font-mono: "SF Mono", "JetBrains Mono", "Menlo", monospace;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
      }

      body {
        overflow: auto;
        font-family: var(--font-ui);
        font-size: 16px;
      }

      a { color: inherit; text-decoration: none; }

      .blog-page {
        min-height: 100vh;
      }

      .blog-page .system-bar {
        position: sticky;
      }

      .blog-stage {
        position: relative;
        z-index: 2;
        min-height: calc(100vh - 44px);
        padding: 36px 24px 56px;
        background: var(--bg-window-strong, rgba(250, 250, 250, 0.96));
      }

      .blog-content {
        width: min(100%, 980px);
        margin: 0 auto;
        padding: 8px 0 0;
      }

      .page {
        width: min(100%, 760px);
        margin: 0 auto;
      }

      .system-right {
        gap: 14px;
      }

      .system-locale {
        gap: 14px;
      }

      .system-locale a {
        position: relative;
        color: var(--ink-dim);
        font-size: 13px;
        transition: color 0.18s ease;
      }

      .system-locale a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -3px;
        height: 1px;
        background: currentColor;
        opacity: 0;
        transition: opacity 0.18s ease;
      }

      .system-locale a:hover,
      .system-locale a.is-active {
        color: var(--ink);
      }

      .system-locale a:hover::after,
      .system-locale a.is-active::after {
        opacity: 1;
      }

      .meta {
        margin-top: 28px;
        display: flex;
        gap: 8px;
        color: var(--dim);
        font-family: var(--font-ui);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .translation-note {
        margin-top: 18px;
        padding: 12px 14px;
        border: 1px solid rgba(24, 24, 24, 0.08);
        border-radius: 12px;
        background: rgba(24, 24, 24, 0.035);
      }

      .translation-note strong,
      .translation-note p {
        display: block;
        margin: 0;
        font-family: var(--font-ui);
      }

      .translation-note strong {
        font-size: 14px;
        font-weight: 600;
        color: #171716;
      }

      .translation-note p {
        margin-top: 4px;
        font-size: 14px;
        line-height: 1.65;
        color: #4f4a42;
      }

      h1 {
        margin: 12px 0 0;
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 4vw, 3rem);
        line-height: 1.08;
        font-weight: 600;
        letter-spacing: -0.03em;
        color: #171716;
      }

      .content {
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
      }

      .content :global(p) {
        margin: 0 0 20px;
        color: #302c27;
        line-height: 1.95;
        font-size: 17px;
        font-weight: 400;
      }

      .content :global(img) {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
        margin: 28px 0;
        border-radius: 14px;
      }

      .content :global(.block-1) {
        margin: 0 0 24px;
        padding: 16px 18px;
        border: 1px solid rgba(24, 24, 24, 0.08);
        border-radius: 14px;
        background: rgba(24, 24, 24, 0.035);
      }

      .content :global(.block-1 p) {
        margin: 0;
        color: #302c27;
        line-height: 1.85;
        font-size: 16px;
      }

      .content :global(.block-1 p + p) {
        margin-top: 10px;
      }

      .content :global(blockquote) {
        margin: 20px 0 20px;
        padding: 14px 18px;
        border-left: 2px solid var(--accent);
        background: var(--accent-soft);
        border-radius: 0 6px 6px 0;
        font-size: 16px;
        line-height: 1.8;
        color: #302c27;
      }

      .content :global(h2) {
        padding: 28px 0 0;
        margin: 0 0 14px;
        font-size: 26px;
        line-height: 1.12;
        font-weight: 600;
        font-family: var(--font-display);
        letter-spacing: -0.02em;
        color: #171716;
      }

      .content :global(h3) {
        margin: 0 0 12px;
        font-size: 19px;
        line-height: 1.22;
        font-weight: 700;
        font-family: var(--font-display);
        color: #1e1e1c;
      }

      .content :global(code) {
        font-family: var(--font-mono);
        font-size: 0.82em;
        padding: 2px 6px;
        border-radius: 4px;
        background: rgba(24, 24, 24, 0.05);
        color: #4b463f;
      }

      .content :global(pre) {
        margin: 24px 0;
        padding: 18px 20px;
        border-radius: 14px;
        background: #20262f;
        overflow-x: auto;
      }

      .content :global(pre code) {
        display: block;
        padding: 0;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font-size: 0.95em;
        line-height: 1.75;
      }

      .content :global(ul),
      .content :global(ol) {
        margin: 0 0 20px;
        padding-left: 22px;
        color: #302c27;
        font-size: 17px;
        line-height: 1.95;
      }

      .content :global(li) {
        margin-bottom: 10px;
      }

      .footer {
        margin-top: 48px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        color: var(--dim);
        font-family: var(--font-ui);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.06em;
      }

      .footer a { color: var(--accent); }
      .footer a:hover { opacity: 0.8; }

      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(24, 24, 24, 0.12); border-radius: 10px; }

      @media (max-width: 720px) {
        .blog-stage {
          padding: 18px 12px 28px;
        }

        .blog-content {
          padding-top: 0;
        }

        .content :global(pre) {
          padding: 16px;
          border-radius: 12px;
        }

      }
    </style>
  </head>
  <body>
    <main class="desktop-page blog-page" data-desktop-wallpaper="paper">
      <div class="desktop-bg" aria-hidden="true">
        <div class="bg-texture"></div>
        <div class="editorial-line"></div>
      </div>

      <header class="system-bar">
        <div class="system-left">
          <a class="os-logo" href="/" aria-label="Back to home"></a>
          <SystemBreadcrumbs items={[
            { label: "Desktop", href: "/" },
            { label: "Blog", href: getBlogIndexPath(locale) },
            { label: post.data.title, current: true }
          ]} />
        </div>
        <div class="system-right">
          <div class="system-locale" aria-label="Blog language switch">
            <a
              class={locale === "zh" ? "is-active" : ""}
              data-blog-locale-switch="zh"
              href={getBlogPostPath("zh", post.data.translationKey)}
            >
              {BLOG_LANGUAGE_SWITCH_LABELS.zh}
            </a>
            <a
              class={locale === "en" ? "is-active" : ""}
              data-blog-locale-switch="en"
              href={getBlogPostPath("en", post.data.translationKey)}
            >
              {BLOG_LANGUAGE_SWITCH_LABELS.en}
            </a>
          </div>
        </div>
      </header>

      <section class="blog-stage">
        <div class="blog-content">
          <main class="page">
            <div class="meta">
              <span>{formatBlogDate(post.data.date)}</span>
            </div>

            {fallbackLocale && (
              <div class="translation-note">
                <strong>{copy.missingTranslationTitle}</strong>
                <p>{copy.missingTranslationDescription(BLOG_LANGUAGE_LABELS[fallbackLocale])}</p>
              </div>
            )}

            <h1>{post.data.title}</h1>
            <article class="content">
              <Content />
            </article>

            <footer class="footer">
              <a href={getBlogIndexPath(locale)}>{copy.moreArticles}</a>
            </footer>
          </main>
        </div>
      </section>
    </main>

    <script type="module" is:inline define:vars={{ locale }}>
      import { setBlogLocalePreference } from "/scripts/locale-preference.js";

      setBlogLocalePreference(locale);
      document.querySelectorAll("[data-blog-locale-switch]").forEach((link) => {
        link.addEventListener("click", () => {
          setBlogLocalePreference(link.getAttribute("data-blog-locale-switch") || locale);
        });
      });
    </script>
  </body>
</html>
