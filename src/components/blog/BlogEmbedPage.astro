---
import { render, type CollectionEntry } from "astro:content";
import type { BlogLocale } from "../../lib/blog";
import { BLOG_COPY, BLOG_LANGUAGE_LABELS, formatBlogDate } from "../../lib/blog";

interface Props {
  locale: BlogLocale;
  post: CollectionEntry<"blog">;
  fallbackLocale?: BlogLocale | null;
}

const { locale, post, fallbackLocale = null } = Astro.props;
const copy = BLOG_COPY[locale];
const { Content } = await render(post);
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{post.data.title}</title>
    <style>
      :root {
        --bg: #fcfaf7;
        --fg: #181818;
        --secondary: #4f4a42;
        --dim: #867e71;
        --border: rgba(24, 24, 24, 0.06);
        --accent: #181818;
        --accent-soft: rgba(24, 24, 24, 0.04);
        --font-display: "SF Pro Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
        --font-ui: Inter, -apple-system, "PingFang SC", sans-serif;
        --font-mono: "SF Mono", "JetBrains Mono", "Menlo", monospace;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
      }

      body { font-family: var(--font-ui); font-size: 16px; }

      .page {
        max-width: 760px;
        margin: 0 auto;
        padding: 38px 60px 42px;
      }

      .meta {
        display: block;
        font-family: var(--font-ui);
        font-size: 14px;
        color: var(--dim);
        letter-spacing: 0;
      }

      .meta span + span::before { content: " · "; }

      .translation-note {
        margin-top: 16px;
        padding: 12px 14px;
        border: 1px solid rgba(24, 24, 24, 0.08);
        border-radius: 12px;
        background: rgba(24, 24, 24, 0.035);
      }

      .translation-note strong,
      .translation-note p {
        display: block;
        margin: 0;
        font-family: var(--font-ui);
      }

      .translation-note strong {
        font-size: 14px;
        font-weight: 600;
        color: #171716;
      }

      .translation-note p {
        margin-top: 4px;
        font-size: 14px;
        line-height: 1.65;
        color: #4f4a42;
      }

      h1 {
        margin: 14px 0 0;
        font-family: var(--font-display);
        font-size: clamp(2rem, 3vw, 2.45rem);
        line-height: 1.08;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--fg);
      }

      .content {
        margin-top: 18px;
      }

      .content :global(p) {
        margin: 0 0 20px;
        line-height: 1.95;
        font-size: 17px;
        font-weight: 400;
        color: #302c27;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .content :global(img) {
        display: block;
        width: 100%;
        max-width: 100%;
        height: auto;
        margin: 28px 0;
        border-radius: 14px;
      }

      .content :global(.block-1) {
        margin: 0 0 24px;
        padding: 16px 18px;
        border: 1px solid rgba(24, 24, 24, 0.08);
        border-radius: 14px;
        background: rgba(24, 24, 24, 0.035);
      }

      .content :global(.block-1 p) {
        margin: 0;
        color: #302c27;
        line-height: 1.85;
        font-size: 16px;
      }

      .content :global(.block-1 p + p) {
        margin-top: 10px;
      }

      .content :global(h2) {
        margin: 0;
        padding: 30px 0 12px;
        font-size: 26px;
        line-height: 1.12;
        font-weight: 600;
        font-family: var(--font-display);
        letter-spacing: -0.02em;
        color: var(--fg);
      }

      .content :global(h3) {
        margin: 0;
        padding: 20px 0 10px;
        font-size: 19px;
        line-height: 1.22;
        font-weight: 700;
        font-family: var(--font-display);
        color: var(--fg);
      }

      .content :global(blockquote) {
        margin: 20px 0 20px;
        padding: 0 0 0 18px;
        border-left: 1px solid var(--accent);
        background: transparent;
        border-radius: 0;
        line-height: 1.8;
        font-size: 16px;
        color: #302c27;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .content :global(a) {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .content :global(code) {
        font-family: var(--font-mono);
        font-size: 0.82em;
        padding: 2px 6px;
        border-radius: 4px;
        background: rgba(24, 24, 24, 0.05);
        color: #4b463f;
      }

      .content :global(pre) {
        margin: 24px 0;
        padding: 18px 20px;
        border-radius: 14px;
        background: #20262f;
        overflow-x: auto;
      }

      .content :global(pre code) {
        display: block;
        padding: 0;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font-size: 0.95em;
        line-height: 1.75;
      }

      .content :global(ul),
      .content :global(ol) {
        margin: 0 0 20px;
        padding-left: 22px;
        color: #302c27;
        font-size: 17px;
        line-height: 1.95;
      }

      .content :global(li) {
        margin-bottom: 8px;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(24, 24, 24, 0.12); border-radius: 10px; }

      @media (max-width: 720px) {
        .page { padding: 26px 20px 36px; }

        .meta {
          font-size: 13px;
        }

        .content :global(p),
        .content :global(blockquote),
        .content :global(ul),
        .content :global(ol) {
          font-size: 17px;
        }

        .content :global(pre) {
          padding: 16px;
          border-radius: 12px;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <div class="meta">
        <span>{formatBlogDate(post.data.date)}</span>
      </div>

      {fallbackLocale && (
        <div class="translation-note">
          <strong>{copy.missingTranslationTitle}</strong>
          <p>{copy.missingTranslationDescription(BLOG_LANGUAGE_LABELS[fallbackLocale])}</p>
        </div>
      )}

      <h1>{post.data.title}</h1>

      <article class="content">
        <Content />
      </article>
    </main>
  </body>
</html>
