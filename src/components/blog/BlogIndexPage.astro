---
import type { BlogLocale, BlogPost } from "../../lib/blog";
import {
  BLOG_COPY,
  BLOG_LANGUAGE_LABELS,
  formatBlogDate,
  getBlogIndexPath,
  getBlogPostPath
} from "../../lib/blog";

interface Props {
  locale: BlogLocale;
  posts: BlogPost[];
}

const { locale, posts } = Astro.props;
const copy = BLOG_COPY[locale];
const alternateLocale = locale === "zh" ? "en" : "zh";
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{locale === "zh" ? "Blog" : "Blog"}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Newsreader:ital,wght@0,300;0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap");

      :root {
        --bg: #0f0f12;
        --fg: #F5F0EB;
        --secondary: rgba(245, 240, 235, 0.55);
        --dim: rgba(245, 240, 235, 0.28);
        --border: rgba(255, 255, 255, 0.06);
        --accent: #FF6B3D;
        --accent-soft: rgba(255, 107, 61, 0.1);
        --font-display: "Newsreader", "STSong", "Georgia", serif;
        --font-ui: "Inter", -apple-system, "PingFang SC", sans-serif;
        --font-mono: "JetBrains Mono", monospace;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
      }

      body { padding: 28px; font-family: var(--font-ui); font-size: 13px; }

      a { color: inherit; text-decoration: none; }

      .page { max-width: 720px; margin: 0 auto; }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 0 18px;
        border-bottom: 1px solid var(--border);
      }

      .topbar strong {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--secondary);
      }

      .topbar nav {
        display: flex;
        gap: 12px;
        color: var(--dim);
        font-size: 12px;
      }

      .topbar nav a:hover { color: var(--fg); }

      .hero { padding: 48px 0 36px; }

      .hero__row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }

      .hero p {
        margin: 0;
        color: var(--dim);
        font-family: var(--font-mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 9px;
      }

      .hero h1 {
        margin: 16px 0 0;
        max-width: 560px;
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        line-height: 1;
        font-weight: 600;
        letter-spacing: -0.035em;
        color: var(--fg);
      }

      .hero__note {
        margin-top: 14px;
        max-width: 450px;
        color: var(--secondary);
        line-height: 1.7;
        font-size: 13px;
      }

      .locale-switch {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border);
        flex-shrink: 0;
      }

      .locale-switch a {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 500;
        color: var(--dim);
        transition: all 0.12s;
      }

      .locale-switch a.is-active {
        background: var(--accent);
        color: white;
      }

      .list { display: grid; padding-bottom: 56px; }

      .item {
        display: grid;
        gap: 8px;
        padding: 24px 0;
        border-top: 1px solid var(--border);
        transition: border-color 0.2s;
      }

      .item:hover { border-color: rgba(255,255,255,0.12); }

      .item__meta {
        display: flex;
        gap: 10px;
        color: var(--dim);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .item h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.2rem, 2.5vw, 1.8rem);
        line-height: 1.15;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--fg);
      }

      .item h2 a:hover { color: var(--accent); }

      .item p {
        margin: 0;
        color: var(--secondary);
        line-height: 1.65;
        font-size: 13px;
      }

      .item__link {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 5px;
        color: var(--accent);
        font-size: 11px;
        font-weight: 500;
        opacity: 0.85;
        transition: opacity 0.12s;
      }

      .item__link:hover { opacity: 1; }

      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 10px; }

      @media (max-width: 720px) {
        body { padding: 18px; }
        .topbar, .hero__row { align-items: start; flex-direction: column; }
        .topbar nav { flex-wrap: wrap; }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="topbar">
        <strong>Blog</strong>
        <nav>
          <a href="/">Home</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero__row">
          <p>{copy.listEyebrow}</p>
          <div class="locale-switch" aria-label="Language switch">
            <a
              class={locale === "zh" ? "is-active" : ""}
              data-blog-locale-switch="zh"
              href={getBlogIndexPath("zh")}
            >
              {BLOG_LANGUAGE_LABELS.zh}
            </a>
            <a
              class={locale === "en" ? "is-active" : ""}
              data-blog-locale-switch="en"
              href={getBlogIndexPath("en")}
            >
              {BLOG_LANGUAGE_LABELS.en}
            </a>
          </div>
        </div>
        <h1>{copy.listTitle}</h1>
        <div class="hero__note">{copy.listDescription}</div>
      </section>

      <section class="list">
        {posts.map((post) => (
          <article class="item">
            <div class="item__meta">
              <span>{formatBlogDate(post.data.date)}</span>
              <span>{post.data.readTime}</span>
            </div>
            <h2>
              <a href={getBlogPostPath(locale, post.data.translationKey)}>{post.data.title}</a>
            </h2>
            <p>{post.data.excerpt}</p>
            <a class="item__link" href={getBlogPostPath(locale, post.data.translationKey)}>
              {copy.readArticle}
            </a>
          </article>
        ))}
      </section>
    </main>

    <script is:inline define:vars={{ locale, alternateLocale }}>
      localStorage.setItem("blog-locale", locale);
      document.querySelectorAll("[data-blog-locale-switch]").forEach((link) => {
        link.addEventListener("click", () => {
          localStorage.setItem("blog-locale", link.getAttribute("data-blog-locale-switch") || alternateLocale);
        });
      });
    </script>
  </body>
</html>
