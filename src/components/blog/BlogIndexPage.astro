---
import type { BlogLocale, BlogPost } from "../../lib/blog";
import {
  BLOG_COPY,
  BLOG_LANGUAGE_LABELS,
  formatBlogDate,
  getBlogIndexPath,
  getBlogPostPath
} from "../../lib/blog";

interface Props {
  locale: BlogLocale;
  posts: BlogPost[];
}

const { locale, posts } = Astro.props;
const copy = BLOG_COPY[locale];
const alternateLocale = locale === "zh" ? "en" : "zh";
---

<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{locale === "zh" ? "Blog" : "Blog"}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/styles/desktop-os.css" />
    <style>
      :root {
        --secondary: #4f4a42;
        --dim: #867e71;
        --border: rgba(24, 24, 24, 0.06);
        --accent: #181818;
        --accent-soft: rgba(24, 24, 24, 0.04);
        --font-display: "SF Pro Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
        --font-ui: Inter, -apple-system, "PingFang SC", sans-serif;
        --font-mono: "SF Mono", "JetBrains Mono", "Menlo", monospace;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
      }

      body {
        overflow: auto;
        font-family: var(--font-ui);
        font-size: 14px;
      }

      a { color: inherit; text-decoration: none; }

      .blog-page {
        min-height: 100vh;
      }

      .blog-page .system-bar {
        position: sticky;
      }

      .blog-stage {
        position: relative;
        z-index: 2;
        min-height: calc(100vh - 44px);
        padding: 36px 24px 56px;
        background: var(--bg-window-strong, rgba(250, 250, 250, 0.96));
      }

      .blog-content {
        width: min(100%, 980px);
        margin: 0 auto;
        padding: 8px 0 0;
      }

      .page {
        width: min(100%, 760px);
        margin: 0 auto;
      }

      .hero {
        padding: 6px 2px 34px;
        border-bottom: 1px solid var(--border);
      }

      .hero__row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }

      .hero p {
        margin: 0;
        color: var(--dim);
        font-family: var(--font-ui);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .hero h1 {
        margin: 16px 0 0;
        max-width: 560px;
        font-family: var(--font-display);
        font-size: clamp(2rem, 4.3vw, 3.8rem);
        line-height: 0.96;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #232320;
      }

      .hero__note {
        margin-top: 14px;
        max-width: 42ch;
        color: var(--secondary);
        line-height: 1.95;
        font-size: 17px;
      }

      .system-right {
        gap: 14px;
      }

      .system-locale {
        gap: 14px;
      }

      .system-locale a {
        position: relative;
        color: var(--ink-dim);
        font-size: 13px;
        transition: color 0.18s ease;
      }

      .system-locale a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -3px;
        height: 1px;
        background: currentColor;
        opacity: 0;
        transition: opacity 0.18s ease;
      }

      .system-locale a:hover,
      .system-locale a.is-active {
        color: var(--ink);
      }

      .system-locale a:hover::after,
      .system-locale a.is-active::after {
        opacity: 1;
      }

      .list {
        display: grid;
        padding: 10px 0 56px;
      }

      .item {
        display: grid;
        gap: 10px;
        padding: 24px 2px;
        border-top: 1px solid var(--border);
        transition: border-color 0.2s;
      }

      .item:hover { border-color: rgba(24, 24, 24, 0.12); }

      .list > .item:first-of-type {
        border-top: 0;
        padding-top: 28px;
      }

      .item__meta {
        display: flex;
        gap: 10px;
        color: var(--dim);
        font-family: var(--font-ui);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .item h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 2.4vw, 2rem);
        line-height: 1.12;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #171716;
      }

      .item h2 a:hover { color: var(--accent); }

      .item p {
        margin: 0;
        color: var(--secondary);
        line-height: 1.9;
        font-size: 17px;
      }

      .item__link {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 5px;
        color: var(--accent);
        font-size: 13px;
        font-weight: 600;
        opacity: 0.85;
        transition: opacity 0.12s;
      }

      .item__link:hover { opacity: 1; }

      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(24, 24, 24, 0.12); border-radius: 10px; }

      @media (max-width: 720px) {
        .blog-stage {
          padding: 18px 12px 28px;
        }

        .blog-content {
          padding-top: 0;
        }

        .hero__row {
          align-items: start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <main class="desktop-page blog-page" data-desktop-wallpaper="paper">
      <div class="desktop-bg" aria-hidden="true">
        <div class="bg-texture"></div>
        <div class="editorial-line"></div>
      </div>

      <header class="system-bar">
        <div class="system-left">
          <a class="os-logo" href="/" aria-label="Back to home"></a>
        </div>
        <div class="system-right">
          <div class="system-locale" aria-label="Blog language switch">
            <a
              class={locale === "zh" ? "is-active" : ""}
              data-blog-locale-switch="zh"
              href={getBlogIndexPath("zh")}
            >
              {BLOG_LANGUAGE_LABELS.zh}
            </a>
            <a
              class={locale === "en" ? "is-active" : ""}
              data-blog-locale-switch="en"
              href={getBlogIndexPath("en")}
            >
              {BLOG_LANGUAGE_LABELS.en}
            </a>
          </div>
          <span>Blog</span>
        </div>
      </header>

      <section class="blog-stage">
        <div class="blog-content">
          <main class="page">
            <section class="hero">
              <div class="hero__row">
                <p>{copy.listEyebrow}</p>
              </div>
              <h1>{copy.listTitle}</h1>
              <div class="hero__note">{copy.listDescription}</div>
            </section>

            <section class="list">
              {posts.map((post) => (
                <article class="item">
                  <div class="item__meta">
                    <span>{formatBlogDate(post.data.date)}</span>
                    <span>{post.data.readTime}</span>
                  </div>
                  <h2>
                    <a href={getBlogPostPath(locale, post.data.translationKey)}>{post.data.title}</a>
                  </h2>
                  <p>{post.data.excerpt}</p>
                  <a class="item__link" href={getBlogPostPath(locale, post.data.translationKey)}>
                    {copy.readArticle}
                  </a>
                </article>
              ))}
            </section>
          </main>
        </div>
      </section>
    </main>

    <script is:inline define:vars={{ locale, alternateLocale }}>
      localStorage.setItem("blog-locale", locale);
      document.querySelectorAll("[data-blog-locale-switch]").forEach((link) => {
        link.addEventListener("click", () => {
          localStorage.setItem("blog-locale", link.getAttribute("data-blog-locale-switch") || alternateLocale);
        });
      });
    </script>
  </body>
</html>
