---
import { getEntry, render } from "astro:content";

const atten = await getEntry("apps", "atten");
if (!atten) {
  throw new Error('App content "atten" not found');
}

const { Content } = await render(atten);
const { title, year, platform, summary } = atten.data;
---

<div class="os-window__scroll">
  <div class="atten">
    <header class="atten__hero">
      <div class="atten__meta">
        <span class="atten__eyebrow">{year}</span>
        <span class="atten__eyebrow">{platform}</span>
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
    </header>

    <article class="atten__article">
      <Content />
    </article>
  </div>
</div>
