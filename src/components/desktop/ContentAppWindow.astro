---
import { getEntry, render } from "astro:content";
import { desktopApps } from "../../data/desktop";

interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = await getEntry("apps", id);
if (!entry) {
  throw new Error(`App content "${id}" not found`);
}

const { Content } = await render(entry);
const {
  title,
  year,
  platform,
  summary,
  tags = [],
  websiteUrl,
  websiteLabel = "访问网站",
  heroImage,
  heroAlt
} = entry.data;

const desktopApp = desktopApps.find((app) => app.id === id);
const heroLogo = desktopApp?.iconSrc ?? heroImage;
const heroLogoAlt = heroAlt ?? `${title} 图标`;
---

<div class="os-window__scroll">
  <div class:list={["content-app", `content-app--${id}`]}>
    <header class:list={["content-app__hero", `${id}__hero`]}>
      <div class:list={["content-app__heroMain", `${id}__heroMain`]}>
        <img
          class:list={["content-app__heroLogo", `${id}__heroLogo`]}
          src={heroLogo}
          alt={heroLogoAlt}
          loading="lazy"
          decoding="async"
        />

        <div class:list={["content-app__heroCopy", `${id}__heroCopy`]}>
          <h2>{title}</h2>
          <p>{summary}</p>
        </div>

        {websiteUrl && (
          <a class:list={["content-app__heroLink", `${id}__heroLink`]} href={websiteUrl} target="_blank" rel="noreferrer">
            {websiteLabel}
          </a>
        )}
      </div>

      <div class:list={["content-app__meta", `${id}__meta`]}>
        <span>{year}</span>
        <span>{platform}</span>
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>

    <article class:list={["content-app__article", `${id}__article`]}>
      <Content />
    </article>
  </div>
</div>
