---
import {
  BLOG_LOCALES,
  DEFAULT_BLOG_LOCALE,
  formatBlogDate,
  getBlogEmbedPath,
  type BlogLocale,
  type BlogPost
} from "../../lib/blog";

interface Props {
  postsByLocale: Record<BlogLocale, BlogPost[]>;
  defaultHref: string;
}

const { postsByLocale, defaultHref } = Astro.props;
---

<section class="blog-browser">
  <aside class="blog-browser__sidebar">
    <div class="blog-browser__sidebar-head">
      <strong>Notebook</strong>
      <div class="blog-browser__locale" aria-label="Blog language switch">
        <button class="is-active" type="button" data-blog-locale-switch="zh">中文</button>
        <button type="button" data-blog-locale-switch="en">English</button>
      </div>
    </div>

    {BLOG_LOCALES.map((locale) => (
      <div class="blog-browser__list" data-blog-list={locale} hidden={locale !== DEFAULT_BLOG_LOCALE}>
        {postsByLocale[locale].map((post, index) => (
          <button
            class:list={["blog-browser__item", locale === DEFAULT_BLOG_LOCALE && index === 0 && "is-active"]}
            type="button"
            data-blog-locale={locale}
            data-blog-target={getBlogEmbedPath(locale, post.data.translationKey)}
          >
            <time>{formatBlogDate(post.data.date)}</time>
            <strong>{post.data.title}</strong>
            <span>{post.data.readTime}</span>
          </button>
        ))}
      </div>
    ))}
  </aside>

  <div class="blog-browser__content">
    <iframe
      class="blog-browser__frame"
      data-blog-frame
      src={defaultHref}
      title="Minimal Blog Reader"
    ></iframe>
  </div>
</section>
