---
import {
  BLOG_LOCALES,
  BLOG_COPY,
  DEFAULT_BLOG_LOCALE,
  BLOG_LANGUAGE_LABELS,
  formatBlogDate,
  getBlogEmbedPath,
  type BlogLocale,
  type BlogPost
} from "../../lib/blog";

interface Props {
  postsByLocale: Record<BlogLocale, BlogPost[]>;
}

const { postsByLocale } = Astro.props;
---

<section class="blog-browser" data-blog-browser>
  <button class="blog-browser__back" type="button" data-blog-back aria-label="返回">
    <svg class="blog-browser__back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" />
    </svg>
  </button>
  <aside class="blog-browser__sidebar" data-scroll-lock>
    {BLOG_LOCALES.map((locale) => (
      <div class="blog-browser__list" data-blog-list={locale} hidden={locale !== DEFAULT_BLOG_LOCALE}>
        {postsByLocale[locale].length > 0 ? (
          postsByLocale[locale].map((post) => (
            <button
              class="blog-browser__item"
              type="button"
              data-blog-locale={locale}
              data-blog-target={getBlogEmbedPath(locale, post.data.translationKey)}
              aria-label={`${BLOG_LANGUAGE_LABELS[locale]} ${post.data.title}`}
            >
              <span class="blog-browser__item-title">{post.data.title}</span>
              <p class="blog-browser__item-excerpt">{post.data.excerpt}</p>
              <time>{formatBlogDate(post.data.date)}</time>
            </button>
          ))
        ) : (
          <section class="blog-browser__empty">
            <h3>{BLOG_COPY[locale].emptyStateTitle}</h3>
            <p>{BLOG_COPY[locale].emptyStateDescription}</p>
          </section>
        )}
      </div>
    ))}
  </aside>

  <div class="blog-browser__content">
    <section class="blog-browser__emptyState" data-blog-empty-state>
      {BLOG_LOCALES.map((locale) => (
        <div data-blog-empty-copy={locale} hidden={locale !== DEFAULT_BLOG_LOCALE}>
          <h3>{BLOG_COPY[locale].embeddedEmptyTitle}</h3>
          <p>{BLOG_COPY[locale].embeddedEmptyDescription}</p>
        </div>
      ))}
    </section>
    <iframe
      class="blog-browser__frame"
      data-blog-frame
      title="Minimal Blog Reader"
      hidden
    ></iframe>
  </div>
</section>
