---
// DesktopCat.astro
---
<div class="cat-layer">
  <div class="cat-hover-area" data-cat-hover aria-hidden="true"></div>
  <div class="art-illustration">
    <svg class="zen-cat-art" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="cat-roughness">
          <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.6" />
        </filter>
      </defs>

      <line
        x1="65"
        y1="159"
        x2="135"
        y2="159"
        stroke="rgba(26, 26, 26, 0.18)"
        stroke-width="2"
        stroke-linecap="round"
      />

      <g class="cat-group hand-drawn" filter="url(#cat-roughness)">
        <path
          class="cat-tail tail-end"
          d="M105,145 C130,145 145,125 145,95 C145,80 135,75 130,82.5"
          fill="none"
          stroke="var(--ink)"
          stroke-width="3.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <g class="cat-body">
          <path
            d="M80,155 C80,125 72.5,80 72.5,55 C72.5,42.5 80,37.5 87.5,37.5 L92.5,47.5 L107.5,47.5 L112.5,37.5 C120,37.5 127.5,42.5 127.5,55 C127.5,80 120,125 120,155 Z"
            fill="var(--bg-canvas)"
            stroke="var(--ink)"
            stroke-width="3.1"
            stroke-linejoin="round"
          />
          <path
            d="M92.5,155 L92.5,130 Q92.5,125 87.5,125"
            fill="none"
            stroke="var(--ink)"
            stroke-width="2.3"
            stroke-linecap="round"
            opacity="0.85"
          />
          <path
            d="M107.5,155 L107.5,130 Q107.5,125 112.5,125"
            fill="none"
            stroke="var(--ink)"
            stroke-width="2.3"
            stroke-linecap="round"
            opacity="0.85"
          />
        </g>

        <g class="cat-head">
          <g class="cat-head-inner">
            <g class="cat-face-features">
              <g class="cat-eyes-container">
                <g class="cat-eye cat-eye-left">
                  <circle class="cat-eye-sclera" cx="89" cy="67.5" r="2.8" fill="none" stroke="none" />
                  <g class="cat-eye-target">
                    <g class="cat-eye-orb">
                      <circle cx="89" cy="67.5" r="2.8" fill="var(--ink)" />
                    </g>
                  </g>
                  <path
                    class="cat-eye-happy"
                    d="M 86.2,67.5 Q 89,65.6 91.8,67.5"
                    fill="none"
                    stroke="var(--ink)"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    opacity="0"
                  />
                </g>

                <g class="cat-eye cat-eye-right">
                  <circle class="cat-eye-sclera" cx="111" cy="67.5" r="2.8" fill="none" stroke="none" />
                  <g class="cat-eye-target">
                    <g class="cat-eye-orb">
                      <circle cx="111" cy="67.5" r="2.8" fill="var(--ink)" />
                    </g>
                  </g>
                  <path
                    class="cat-eye-happy"
                    d="M 108.2,67.5 Q 111,65.6 113.8,67.5"
                    fill="none"
                    stroke="var(--ink)"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    opacity="0"
                  />
                </g>
              </g>

              <circle class="cat-nose" cx="100" cy="71.5" r="1.4" fill="var(--ink)" />
              <path
                class="cat-philtrum"
                d="M100,73 L100,76"
                fill="none"
                stroke="var(--ink)"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <g class="cat-mouth-group">
                <path
                  class="cat-mouth-normal"
                  d="M99,77.5 C101,79 103,77 104,76"
                  fill="none"
                  stroke="var(--ink)"
                  stroke-width="2"
                  stroke-linecap="round"
                />
                <path
                  class="cat-mouth-speaking"
                  d="M98.3,77.5 C98.3,79.7 101.7,79.7 101.7,77.5 C101.7,76.1 98.3,76.1 98.3,77.5 Z"
                  fill="none"
                  stroke="var(--ink)"
                  stroke-width="1.5"
                  opacity="0"
                />
                <path
                  class="cat-mouth-happy"
                  d="M96,76.2 Q100,80.2 104,76.2"
                  fill="none"
                  stroke="var(--ink)"
                  stroke-width="2"
                  stroke-linecap="round"
                  opacity="0"
                />
              </g>

              <g class="cat-whiskers-left">
                <line x1="84" y1="75" x2="75" y2="74" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" />
                <line x1="84" y1="79" x2="75" y2="80.5" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" />
              </g>
              <g class="cat-whiskers-right">
                <line x1="116" y1="75" x2="125" y2="74" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" />
                <line x1="116" y1="79" x2="125" y2="80.5" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" />
              </g>
            </g>
          </g>
        </g>
      </g>
    </svg>
    <div class="cat-speech-bubble" aria-hidden="true" data-cat-speech>
      <span class="cat-speech-text" data-cat-text></span>
    </div>
  </div>
</div>
