---
import { getDesktopAppName, type DesktopApp } from "../../data/desktop";
import LanguageSettingsIcon from "./LanguageSettingsIcon.astro";

interface Props {
  apps: DesktopApp[];
}

const { apps } = Astro.props;
const visibleApps = apps.filter((app) => app.showOnDesktop !== false);
---

<div class="desktop-icons" aria-label="Desktop applications">
  {visibleApps.map((app) => (
    <button
      class="desktop-icon"
      type="button"
      data-open-window={app.id}
      style={`--icon-x:${app.iconX}px; --icon-y:${app.iconY}px;`}
    >
      <span class="desktop-icon__plate" aria-hidden="true">
        {app.groupMembers ? (
          <span class="desktop-icon__group-preview">
            {Array.from({ length: 4 }, (_, index) => {
              const member = app.groupMembers?.[index];

              return (
                <span class:list={["desktop-icon__group-cell", !member && "is-empty"]}>
                  {member ? (
                    member.iconSrc ? (
                      <img class="desktop-icon__group-image" src={member.iconSrc} alt="" />
                    ) : (
                      <span class="desktop-icon__group-glyph serif">{member.glyph}</span>
                    )
                  ) : null}
                </span>
              );
            })}
          </span>
        ) : app.iconSrc ? (
          app.id === "settings" ? (
            <LanguageSettingsIcon />
          ) : (
            <img class="desktop-icon__image" src={app.iconSrc} alt={`${app.name} icon`} />
          )
        ) : (
          <span class="desktop-icon__glyph serif">{app.glyph}</span>
        )}
      </span>
      {
        app.localizedName ? (
          <span class="desktop-icon__label" data-app-locale-root>
            <span data-app-locale="zh">{getDesktopAppName(app, "zh")}</span>
            <span data-app-locale="en" hidden>{getDesktopAppName(app, "en")}</span>
          </span>
        ) : (
          <span class="desktop-icon__label">{app.name}</span>
        )
      }
    </button>
  ))}
</div>
