---
import type { DesktopApp, DesktopLocalizedName } from "../../data/desktop";
import AttenWindow from "./AttenWindow.astro";
import DesktopBlogWindow from "./DesktopBlogWindow.astro";
import AppGroupWindow from "./AppGroupWindow.astro";
import DeepChatWindow from "./DeepChatWindow.astro";
import ExistenceWindow from "./ExistenceWindow.astro";
import InterludeWindow from "./InterludeWindow.astro";
import MoldayWindow from "./MoldayWindow.astro";
import SekaiWindow from "./SekaiWindow.astro";
import JikeIdeasWindow from "./JikeIdeasWindow.astro";
import OneSnapWindow from "./OneSnapWindow.astro";
import ProductPlaceholderWindow from "./ProductPlaceholderWindow.astro";
import ContentAppWindow from "./ContentAppWindow.astro";
import DogcheckWindow from "./DogcheckWindow.astro";
import NewPortalWindow from "./NewPortalWindow.astro";
import ReadEasyWindow from "./ReadEasyWindow.astro";
import SettingsWindow from "./SettingsWindow.astro";
import StudioWindow from "./StudioWindow.astro";
import TubeNitroWindow from "./TubeNitroWindow.astro";
import VibaryWindow from "./VibaryWindow.astro";
import WindowFrame from "./WindowFrame.astro";

interface Props {
  apps: DesktopApp[];
  blogPostsByLocale: Record<string, unknown>;
  defaultBlogHref: string;
}

interface WindowDefinition {
  appId: string;
  title?: string;
  localizedTitle?: DesktopLocalizedName;
  component:
    | typeof StudioWindow
    | typeof DesktopBlogWindow
    | typeof ReadEasyWindow
    | typeof VibaryWindow
    | typeof SettingsWindow
    | typeof JikeIdeasWindow
    | typeof AttenWindow
    | typeof DeepChatWindow
    | typeof ExistenceWindow
    | typeof InterludeWindow
    | typeof MoldayWindow
    | typeof OneSnapWindow
    | typeof TubeNitroWindow
    | typeof ProductPlaceholderWindow
    | typeof AppGroupWindow;
  componentProps?: Record<string, unknown>;
  variant?: "default" | "group";
  zIndex?: number;
}

const { apps, blogPostsByLocale, defaultBlogHref } = Astro.props;
const appById = new Map(apps.map((app) => [app.id, app]));

const getApp = (id: string) => {
  const app = appById.get(id);
  if (!app) throw new Error(`Desktop app "${id}" not found`);
  return app;
};

const windowDefinitions: WindowDefinition[] = [
  { appId: "profile", component: StudioWindow, zIndex: 12 },
  {
    appId: "blog",
    component: DesktopBlogWindow,
    componentProps: { postsByLocale: blogPostsByLocale, defaultHref: defaultBlogHref },
    zIndex: 14
  },
  { appId: "read-easy", title: "Read Easy", component: ReadEasyWindow },
  { appId: "vibary", title: "Vibary", component: VibaryWindow },
  { appId: "settings", title: "Settings", component: SettingsWindow },
  { appId: "jike", component: JikeIdeasWindow },
  {
    appId: "atten",
    title: "Atten",
    component: AttenWindow
  },
  {
    appId: "interlude",
    title: "Interlude",
    component: InterludeWindow
  },
  {
    appId: "molday",
    title: "Molday.",
    component: MoldayWindow
  },
  {
    appId: "onesnap",
    title: "OneSnap",
    component: OneSnapWindow
  },
  {
    appId: "tubenitro",
    title: "TubeNitro",
    component: TubeNitroWindow
  },
  { appId: "new-portal", title: "New Portal", component: NewPortalWindow },
  {
    appId: "deepchat",
    title: "DeepChat",
    component: DeepChatWindow
  },
  { appId: "dogcheck", title: "DogCheck", component: DogcheckWindow },
  {
    appId: "existence",
    title: "Existence",
    component: ExistenceWindow
  },
  {
    appId: "sekai",
    title: "sekai",
    component: SekaiWindow
  },
  {
    appId: "sprint",
    title: "Sprint",
    component: AppGroupWindow,
    componentProps: { groupId: "sprint", items: getApp("sprint").groupMembers || [] },
    variant: "group"
  },
  {
    appId: "fun",
    title: "Fun",
    component: AppGroupWindow,
    componentProps: { groupId: "fun", items: getApp("fun").groupMembers || [] },
    variant: "group"
  },
  {
    appId: "reflex-ai",
    title: "Reflex AI",
    component: AppGroupWindow,
    componentProps: { groupId: "reflex-ai", items: getApp("reflex-ai").groupMembers || [] },
    variant: "group"
  }
];
---

<div class="desktop-window-layer">
  {windowDefinitions.map(({ appId, title, localizedTitle, component: Component, componentProps = {}, variant, zIndex }) => (
    <WindowFrame
      app={getApp(appId)}
      title={title ?? getApp(appId).name}
      localizedTitle={localizedTitle ?? getApp(appId).localizedName}
      variant={variant}
      zIndex={zIndex}
    >
      {appId === "blog" && (
        <div slot="trailing" class="blog-window__title-actions">
          <span class="blog-window__title-actionWrap" data-tooltip="复制文章链接">
            <button
              class="blog-window__title-action blog-window__title-action--link"
              type="button"
              data-blog-copy-link
              aria-label="复制文章链接"
              disabled
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07L11 5"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07L13 19"></path>
              </svg>
            </button>
          </span>
          <span class="blog-window__title-actionWrap" data-tooltip="打开独立页面">
            <button
              class="blog-window__title-action blog-window__title-action--open"
              type="button"
              data-blog-open-page
              aria-label="打开独立页面"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 5h5v5"></path>
                <path d="M10 14 19 5"></path>
                <path d="M19 14v3a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3"></path>
              </svg>
            </button>
          </span>
        </div>
      )}
      <Component {...componentProps} />
    </WindowFrame>
  ))}
</div>
