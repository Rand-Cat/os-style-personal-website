---
import { getEntry, render } from "astro:content";

const existence = await getEntry("apps", "existence");
if (!existence) {
  throw new Error('App content "existence" not found');
}

const { Content } = await render(existence);
const { title, year, platform, summary } = existence.data;
---

<div class="os-window__scroll existence">
  <header class="existence__hero">
    <div class="existence__meta">
      <span class="existence__eyebrow">{year}</span>
      <span class="existence__eyebrow">{platform}</span>
    </div>
    <h2>{title}</h2>
    <p>{summary}</p>
  </header>

  <article class="existence__article">
    <Content />
  </article>
</div>
