---
const funApps = [
  { id: "deepchat", name: "DeepChat", glyph: "DC", iconSrc: "/icons/deepchat.png" },
  { id: "dogcheck", name: "DogCheck", glyph: "DG", iconSrc: "/icons/DogCheck.png" }
];
---

<div class="social-group">
  {funApps.map((item) => (
    <button
      class="social-group__item social-group__item--button"
      type="button"
      data-open-window={item.id}
      data-close-group="fun"
    >
      <span class="social-group__icon">
        <img class="social-group__icon-image" src={item.iconSrc} alt="" />
      </span>
      <strong>{item.name}</strong>
    </button>
  ))}
</div>
