---
import { getEntry, render } from "astro:content";

const interlude = await getEntry("apps", "interlude");
if (!interlude) {
  throw new Error('App content "interlude" not found');
}

const { Content } = await render(interlude);
const { title, year, platform, summary } = interlude.data;
---

<div class="os-window__scroll">
  <div class="interlude">
    <header class="interlude__hero">
      <div class="interlude__meta">
        <span class="interlude__eyebrow">{year}</span>
        <span class="interlude__eyebrow">{platform}</span>
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
    </header>

    <article class="interlude__article">
      <Content />
    </article>
  </div>
</div>
