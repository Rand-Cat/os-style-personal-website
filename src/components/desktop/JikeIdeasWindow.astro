---
import {
  getJikeUiCopy,
  getLocalizedJikePost,
  hasJikeTranslation,
  jikeArchiveFeed
} from "../../data/jike";
import JikeCardContent from "./JikeCardContent.astro";

const zhCopy = getJikeUiCopy("zh");
const enCopy = getJikeUiCopy("en");

const localizedFeed = jikeArchiveFeed.map((post) => ({
  year: post.year,
  zh: getLocalizedJikePost(post, "zh"),
  en: getLocalizedJikePost(post, "en"),
  hasEnTranslation: hasJikeTranslation(post.id)
}));
---

<div class="os-window__scroll">
  <div class="jike-archive">
    <section class="jike-archive__intro" data-app-locale-root>
      <div data-app-locale="zh">
        <h2>{zhCopy.title}</h2>
        <p>{zhCopy.description}</p>
      </div>
      <div data-app-locale="en" hidden>
        <h2>{enCopy.title}</h2>
        <p>{enCopy.description}</p>
      </div>
    </section>

    <div class="jike-archive__feed">
      {localizedFeed.map((post, index) => (
        <>
          {index === 0 || localizedFeed[index - 1].year !== post.year ? (
            <div class="jike-archive__year-label">{post.year}</div>
          ) : null}

          <article class="jike-card" data-app-locale-root>
            <div data-app-locale="zh">
              <JikeCardContent post={post.zh} copy={zhCopy} />
            </div>
            {
              post.hasEnTranslation ? (
                <div data-app-locale="en" hidden>
                  <JikeCardContent post={post.en} copy={enCopy} />
                </div>
              ) : null
            }
          </article>
        </>
      ))}
    </div>

    <div class="jike-lightbox" hidden data-jike-lightbox>
      <div class="jike-lightbox__backdrop" data-jike-lightbox-close></div>
      <div class="jike-lightbox__dialog">
        <div class="jike-lightbox__toolbar">
          <span class="jike-lightbox__counter" data-jike-lightbox-counter></span>
          <button class="jike-lightbox__close" type="button" aria-label="Close image preview" data-jike-lightbox-close>
            <span data-app-locale-root>
              <span data-app-locale="zh">{zhCopy.closePreview}</span>
              <span data-app-locale="en" hidden>{enCopy.closePreview}</span>
            </span>
          </button>
        </div>
        <div class="jike-lightbox__viewport">
          <button
            class="jike-lightbox__nav is-prev"
            type="button"
            aria-label="View previous image"
            data-jike-lightbox-prev
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M9.75 3.5 5.25 8l4.5 4.5"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              ></path>
            </svg>
          </button>
          <img class="jike-lightbox__image" alt="" data-jike-lightbox-image />
          <button
            class="jike-lightbox__nav is-next"
            type="button"
            aria-label="View next image"
            data-jike-lightbox-next
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="m6.25 3.5 4.5 4.5-4.5 4.5"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
