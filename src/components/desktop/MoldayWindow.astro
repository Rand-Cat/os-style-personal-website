---
import { getEntry, render } from "astro:content";

const molday = await getEntry("apps", "molday");
if (!molday) {
  throw new Error('App content "molday" not found');
}

const { Content } = await render(molday);
const { title, year, platform, summary } = molday.data;
---

<div class="os-window__scroll">
  <div class="molday">
    <header class="molday__hero">
      <div class="molday__meta">
        <span class="molday__eyebrow">{year}</span>
        <span class="molday__eyebrow">{platform}</span>
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
    </header>

    <article class="molday__article">
      <Content />
    </article>
  </div>
</div>
