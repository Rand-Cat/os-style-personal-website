---
import { getEntry, render } from "astro:content";

const readEasy = await getEntry("apps", "read-easy");
if (!readEasy) {
  throw new Error('App content "read-easy" not found');
}

const { Content } = await render(readEasy);
const {
  title,
  year,
  summary,
  tags = [],
  titleTag,
  websiteUrl,
  websiteLabel = "访问网站",
  heroImage,
  heroAlt = "Read Easy"
} = readEasy.data;

type MetaTag = {
  label: string;
  iconSrc?: string;
  iconKey?: "ios" | "web" | "extension";
};

const resolveMetaTag = (value?: string): MetaTag | undefined => {
  if (!value) return;

  const label = value.trim();
  const normalized = label.toLowerCase();

  if (!label) return;

  if (normalized === "ios" || normalized.startsWith("ios ") || normalized.endsWith(" ios")) {
    return { label, iconSrc: "/icons/brand/apple-mark.svg", iconKey: "ios" };
  }

  if (normalized === "web" || normalized.includes("网站")) {
    return { label, iconSrc: "/icons/brand/web-globe.svg", iconKey: "web" };
  }

  if (
    normalized.includes("chrome extension") ||
    normalized === "extension" ||
    normalized.includes("插件") ||
    normalized.includes("chrome 扩展")
  ) {
    return { label, iconSrc: "/icons/brand/chrome-official-64.png", iconKey: "extension" };
  }

  return { label };
};

const metaTags: MetaTag[] = [];
const seenMetaTagLabels = new Set<string>();

const pushMetaTag = (tag?: MetaTag) => {
  if (!tag) return;

  const key = tag.iconKey ?? tag.label.trim().toLowerCase();
  if (!key || seenMetaTagLabels.has(key)) return;

  seenMetaTagLabels.add(key);
  metaTags.push(tag);
};

pushMetaTag(year ? { label: year } : undefined);
pushMetaTag(titleTag ? { label: titleTag } : undefined);
tags.forEach((tag) => pushMetaTag(resolveMetaTag(tag)));
---

<div class="os-window__scroll">
  <div class:list={["content-app", "content-app--read-easy", "read-easy"]} data-read-easy-window>
    <header class="content-app__hero read-easy__hero">
      <div class="content-app__heroMain">
        <img class="content-app__heroLogo" src={heroImage} alt={heroAlt} loading="lazy" decoding="async" />

        <div class="content-app__heroCopy">
          <h2>{title}</h2>
          <p>{summary}</p>
        </div>

        {websiteUrl && (
          <a class="content-app__heroLink" href={websiteUrl} target="_blank" rel="noreferrer">
            {websiteLabel}
          </a>
        )}
      </div>

      <div class="content-app__meta">
        {metaTags.map(({ label, iconSrc }) => (
          <span>
            {iconSrc && (
              <img
                class="content-app__metaIcon"
                src={iconSrc}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            {label}
          </span>
        ))}
      </div>
    </header>

    <article class="content-app__article read-easy__article">
      <Content />
    </article>
  </div>
</div>
