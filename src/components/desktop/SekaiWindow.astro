---
import { getEntry, render } from "astro:content";

const sekai = await getEntry("apps", "sekai");
if (!sekai) {
  throw new Error('App content "sekai" not found');
}

const { Content } = await render(sekai);
const { title, year, platform, summary } = sekai.data;
---

<div class="os-window__scroll">
  <div class="sekai">
    <header class="sekai__hero">
      <div class="sekai__meta">
        <span class="sekai__eyebrow">{year}</span>
        <span class="sekai__eyebrow">{platform}</span>
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
    </header>

    <article class="sekai__article">
      <Content />
    </article>
  </div>
</div>
