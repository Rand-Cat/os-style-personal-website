<div class="os-window__scroll">
  <section class="settings-panel" role="radiogroup" aria-label="Site language">
    <button
      class="settings-language__option"
      type="button"
      data-blog-locale-switch="zh"
      aria-pressed="false"
    >
      <strong>中文</strong>
      <span class="settings-language__state" aria-hidden="true"></span>
    </button>

    <button
      class="settings-language__option"
      type="button"
      data-blog-locale-switch="en"
      aria-pressed="false"
    >
      <strong>English</strong>
      <span class="settings-language__state" aria-hidden="true"></span>
    </button>
  </section>
</div>
