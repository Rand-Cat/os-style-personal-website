---
import { render } from "astro:content";
import { APP_LOCALES, getLocalizedAppEntries } from "../../lib/apps";

const { entriesByLocale } = await getLocalizedAppEntries("profile");

const localizedEntries = await Promise.all(
  APP_LOCALES.map(async (locale) => {
    const entry = entriesByLocale[locale];
    if (!entry) return null;

    const { Content } = await render(entry);
    return {
      locale,
      title: entry.data.title,
      Content
    };
  })
);

const localizedViews = localizedEntries.filter(
  (entry): entry is NonNullable<(typeof localizedEntries)[number]> => Boolean(entry)
);
---

<div class="os-window__scroll">
  <div class="studio" data-app-locale-root data-app-id="profile">
    {localizedViews.map(({ locale, title, Content }) => (
      <section data-app-locale={locale} hidden={locale !== "zh"}>
        <header class="studio__hero">
          <h2>{title}</h2>
        </header>

        <article class="studio__article">
          <Content />
        </article>
      </section>
    ))}
  </div>
</div>
