---
import { getEntry, render } from "astro:content";

const tubeNitro = await getEntry("apps", "tubenitro");
if (!tubeNitro) {
  throw new Error('App content "tubenitro" not found');
}

const { Content } = await render(tubeNitro);
const { title, year, platform, summary } = tubeNitro.data;
---

<div class="os-window__scroll">
  <div class="tubenitro">
    <header class="tubenitro__hero">
      <div class="tubenitro__meta">
        <span class="tubenitro__eyebrow">{year}</span>
        <span class="tubenitro__eyebrow">{platform}</span>
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
    </header>

    <article class="tubenitro__article">
      <Content />
    </article>
  </div>
</div>
