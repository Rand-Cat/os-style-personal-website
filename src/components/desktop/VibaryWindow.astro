---
import { getEntry, render } from "astro:content";

const vibary = await getEntry("apps", "vibary");
if (!vibary) {
  throw new Error('App content "vibary" not found');
}

const { Content } = await render(vibary);
const {
  title,
  year,
  platform,
  summary,
  tags = [],
  websiteUrl = "https://www.vibary.art/",
  websiteLabel = "访问网站",
  heroImage,
  heroAlt
} = vibary.data;
---

<div class="os-window__scroll">
  <div class="vibary">
    <header class="vibary__hero">
      <div class="vibary__heroMain">
        <img class="vibary__heroLogo" src={heroImage} alt={heroAlt} loading="lazy" decoding="async" />

        <div class="vibary__heroCopy">
          <h2>{title}</h2>
          <p>{summary}</p>
        </div>

        <a class="vibary__heroLink" href={websiteUrl} target="_blank" rel="noreferrer">
          {websiteLabel}
        </a>
      </div>

      <div class="vibary__meta">
        <span>{year}</span>
        <span>{platform}</span>
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>

    <article class="vibary__article">
      <Content />
    </article>
  </div>
</div>
