---
import { getEntry, render } from "astro:content";

const vibary = await getEntry("apps", "vibary");
if (!vibary) {
  throw new Error('App content "vibary" not found');
}

const { Content } = await render(vibary);
const { title, year, platform, summary } = vibary.data;
---

<div class="os-window__scroll">
  <div class="vibary">
    <header class="vibary__hero">
      <div class="vibary__meta">
        <span class="vibary__eyebrow">{year}</span>
        <span class="vibary__eyebrow">{platform}</span>
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
    </header>

    <article class="vibary__article">
      <Content />
    </article>
  </div>
</div>
