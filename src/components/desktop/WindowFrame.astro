---
import type { DesktopApp, DesktopLocalizedName } from "../../data/desktop";

interface Props {
  app: DesktopApp;
  title: string;
  localizedTitle?: DesktopLocalizedName;
  open?: boolean;
  zIndex?: number;
  variant?: "default" | "group";
}

const { app, title, localizedTitle, open = false, zIndex, variant = "default" } = Astro.props;
const zIndexStyle = zIndex ? `z-index:${zIndex};` : "";
---

<section
  class:list={["os-window", variant === "group" && "os-window--group", open && "is-open"]}
  data-window={app.id}
  data-x={String(app.x)}
  data-y={String(app.y)}
  data-default-x={String(app.x)}
  data-default-y={String(app.y)}
  data-default-width={String(app.width)}
  data-default-height={String(app.height)}
  data-min-width="320"
  data-min-height="240"
  style={`--x:${app.x}px; --y:${app.y}px; width:${app.width}px; height:${app.height}px; ${zIndexStyle}`}
>
  {
    variant === "group" ? (
        <div class="os-window__group-overlay" data-group-overlay>
        <div class="os-window__group-stack" data-group-stack>
          <h2 class="os-window__group-title serif">
            {
              localizedTitle ? (
                <span data-app-locale-root>
                  <span data-app-locale="zh">{localizedTitle.zh}</span>
                  <span data-app-locale="en" hidden>{localizedTitle.en}</span>
                </span>
              ) : (
                title
              )
            }
          </h2>
          <div class="os-window__group-panel" data-group-panel>
            <div class="os-window__body">
              <slot />
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="os-window__titlebar" data-drag-handle>
        <div class="os-window__toolbar os-window__toolbar--left">
          <div class="os-window__controls">
            <button class="close" type="button" data-close-window={app.id} aria-label="关闭">
              <span class="os-window__control-icon os-window__control-icon--close" aria-hidden="true"></span>
            </button>
            <button class="minimize" type="button" data-minimize-window={app.id} aria-label="最小化">
              <span class="os-window__control-icon os-window__control-icon--minimize" aria-hidden="true"></span>
            </button>
            <button class="expand" type="button" data-toggle-maximize-window={app.id} aria-label="最大化">
              <span class="os-window__control-icon os-window__control-icon--expand" aria-hidden="true"></span>
            </button>
          </div>
          <slot name="leading" />
        </div>
        <div class="os-window__meta">
          <strong>
            {
              localizedTitle ? (
                <span data-app-locale-root>
                  <span data-app-locale="zh">{localizedTitle.zh}</span>
                  <span data-app-locale="en" hidden>{localizedTitle.en}</span>
                </span>
              ) : (
                title
              )
            }
          </strong>
        </div>
        <div class="os-window__toolbar os-window__toolbar--right">
          <slot name="trailing" />
        </div>
        <button class="os-window__close-mobile" type="button" data-close-window={app.id} aria-label="返回桌面">
          <span class="os-window__close-mobile-dot" aria-hidden="true"></span>
        </button>
      </div>
    )
  }
  {
    variant === "group" ? null : (
      <>
        <div class="os-window__body"><slot /></div>
        <div class="os-window__interaction-shield" aria-hidden="true"></div>
      </>
    )
  }
  {
    variant === "group" ? null : (
      <>
        <button
          class="os-window__resize-handle os-window__resize-handle--n"
          type="button"
          aria-label="向上调整窗口大小"
          data-resize-handle
          data-resize-direction="n"
        ></button>
        <button
          class="os-window__resize-handle os-window__resize-handle--s"
          type="button"
          aria-label="向下调整窗口大小"
          data-resize-handle
          data-resize-direction="s"
        ></button>
        <button
          class="os-window__resize-handle os-window__resize-handle--e"
          type="button"
          aria-label="向右调整窗口大小"
          data-resize-handle
          data-resize-direction="e"
        ></button>
        <button
          class="os-window__resize-handle os-window__resize-handle--w"
          type="button"
          aria-label="向左调整窗口大小"
          data-resize-handle
          data-resize-direction="w"
        ></button>
        <button
          class="os-window__resize-handle os-window__resize-handle--ne"
          type="button"
          aria-label="向右上调整窗口大小"
          data-resize-handle
          data-resize-direction="ne"
        ></button>
        <button
          class="os-window__resize-handle os-window__resize-handle--nw"
          type="button"
          aria-label="向左上调整窗口大小"
          data-resize-handle
          data-resize-direction="nw"
        ></button>
        <button
          class="os-window__resize-handle os-window__resize-handle--se"
          type="button"
          aria-label="向右下调整窗口大小"
          data-resize-handle
          data-resize-direction="se"
        ></button>
        <button
          class="os-window__resize-handle os-window__resize-handle--sw"
          type="button"
          aria-label="向左下调整窗口大小"
          data-resize-handle
          data-resize-direction="sw"
        ></button>
      </>
    )
  }
</section>
