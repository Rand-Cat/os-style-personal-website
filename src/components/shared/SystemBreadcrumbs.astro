---
interface BreadcrumbItem {
  label: string;
  href?: string;
  current?: boolean;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="system-breadcrumbs" aria-label="Breadcrumb">
  <ol class="system-breadcrumbs__list">
    {items.map((item, index) => (
      <li class="system-breadcrumbs__item">
        {item.href && !item.current ? (
          <a class="system-breadcrumbs__link" href={item.href}>
            {item.label}
          </a>
        ) : (
          <span class:list={["system-breadcrumbs__label", item.current && "is-current"]} aria-current={item.current ? "page" : undefined}>
            {item.label}
          </span>
        )}
        {index < items.length - 1 && (
          <span class="system-breadcrumbs__sep" aria-hidden="true">{">"}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .system-breadcrumbs {
    color: var(--ink-dim);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .system-breadcrumbs__list {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .system-breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .system-breadcrumbs__link,
  .system-breadcrumbs__label {
    white-space: nowrap;
  }

  .system-breadcrumbs__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .system-breadcrumbs__link:hover {
    color: var(--ink);
  }

  .system-breadcrumbs__label.is-current {
    color: var(--ink);
  }

  .system-breadcrumbs__sep {
    color: var(--ink-dim);
  }

  @media (max-width: 720px) {
    .system-breadcrumbs__list {
      gap: 6px;
    }

    .system-breadcrumbs__item {
      gap: 6px;
    }
  }
</style>
