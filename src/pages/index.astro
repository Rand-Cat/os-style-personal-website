---
import DesktopCat from "../components/desktop/DesktopCat.astro";
import DesktopDock from "../components/desktop/DesktopDock.astro";
import DesktopIcons from "../components/desktop/DesktopIcons.astro";
import DesktopWindows from "../components/desktop/DesktopWindows.astro";
import { desktopApps } from "../data/desktop";
import {
  BLOG_LOCALES,
  BLOG_LANGUAGE_LABELS,
  DEFAULT_BLOG_LOCALE,
  getBlogEmbedPath,
  getBlogIndexPath,
  getPublishedBlogPosts
} from "../lib/blog";

const blogPostsByLocale = Object.fromEntries(
  await Promise.all(
    BLOG_LOCALES.map(async (locale) => [locale, await getPublishedBlogPosts(locale)] as const)
  )
);

const defaultBlogPosts = blogPostsByLocale[DEFAULT_BLOG_LOCALE];
const defaultBlogHref = defaultBlogPosts[0]
  ? getBlogEmbedPath(DEFAULT_BLOG_LOCALE, defaultBlogPosts[0].data.translationKey)
  : getBlogIndexPath(DEFAULT_BLOG_LOCALE);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ZG OS</title>
    <meta name="description" content="Zhi Jie Gao — Product designer, builder, writer." />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/styles/desktop-os.css" />
  </head>
  <body>
    <main class="desktop-page" data-desktop-wallpaper="custom">
      <div class="desktop-bg" aria-hidden="true">
        <!-- Paper Texture Overlay -->
        <div class="bg-texture"></div>
        
        <DesktopCat />

        <!-- Editorial Elements -->
        <div class="editorial-line"></div>
        <div class="editorial-mark">fig. 06 &mdash; minimal</div>
      </div>

      <header class="system-bar">
        <div class="system-left">
          <div class="os-logo" aria-hidden="true"></div>
          <span>ZG OS</span>
        </div>
        <div class="system-right">
          <div class="system-locale" aria-label="Blog language switch">
            {BLOG_LOCALES.map((locale, index) => (
              <button
                class:list={[index === 0 && "is-active"]}
                type="button"
                data-blog-locale-switch={locale}
              >
                {BLOG_LANGUAGE_LABELS[locale]}
              </button>
            ))}
          </div>
          <span>Memory 32%</span>
          <span>Network Link</span>
          <span>Focus Mode</span>
          <time id="clock">--:--</time>
        </div>
      </header>

      <section class="desktop-stage" data-desktop-stage>
        <div class="desktop-widget">
          <div class="widget-time" data-widget-time>--:--</div>
          <div class="widget-date" data-widget-date>Loading date</div>
        </div>

        <DesktopIcons apps={desktopApps} />

        <DesktopWindows
          apps={desktopApps}
          blogPostsByLocale={blogPostsByLocale}
          defaultBlogHref={defaultBlogHref}
        />

        <DesktopDock apps={desktopApps} />
      </section>

      <div class="cat-hover-area" data-cat-hover aria-hidden="true"></div>
    </main>

    <script type="module" src="/scripts/desktop-os.js"></script>
  </body>
</html>
