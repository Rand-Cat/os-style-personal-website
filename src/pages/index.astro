---
import DesktopBlogWindow from "../components/desktop/DesktopBlogWindow.astro";
import DesktopDock from "../components/desktop/DesktopDock.astro";
import DesktopIcons from "../components/desktop/DesktopIcons.astro";
import ProductPlaceholderWindow from "../components/desktop/ProductPlaceholderWindow.astro";
import ReadEasyWindow from "../components/desktop/ReadEasyWindow.astro";
import SettingsWindow from "../components/desktop/SettingsWindow.astro";
import SocialFolderWindow from "../components/desktop/SocialFolderWindow.astro";
import StudioWindow from "../components/desktop/StudioWindow.astro";
import VibaryWindow from "../components/desktop/VibaryWindow.astro";
import WindowFrame from "../components/desktop/WindowFrame.astro";
import { desktopApps } from "../data/desktop";
import {
  BLOG_LOCALES,
  BLOG_LANGUAGE_LABELS,
  DEFAULT_BLOG_LOCALE,
  getBlogEmbedPath,
  getBlogIndexPath,
  getPublishedBlogPosts
} from "../lib/blog";

const blogPostsByLocale = Object.fromEntries(
  await Promise.all(
    BLOG_LOCALES.map(async (locale) => [locale, await getPublishedBlogPosts(locale)] as const)
  )
);

const defaultBlogPosts = blogPostsByLocale[DEFAULT_BLOG_LOCALE];
const defaultBlogHref = defaultBlogPosts[0]
  ? getBlogEmbedPath(DEFAULT_BLOG_LOCALE, defaultBlogPosts[0].data.translationKey)
  : getBlogIndexPath(DEFAULT_BLOG_LOCALE);
const getDesktopApp = (id: string) => {
  const app = desktopApps.find((item) => item.id === id);
  if (!app) throw new Error(`Desktop app "${id}" not found`);
  return app;
};

const studioApp = getDesktopApp("profile");
const readEasyApp = getDesktopApp("read-easy");
const blogApp = getDesktopApp("blog");
const vibaryApp = getDesktopApp("vibary");
const settingsApp = getDesktopApp("settings");
const attenApp = getDesktopApp("atten");
const interludeApp = getDesktopApp("interlude");
const moldayApp = getDesktopApp("molday");
const onesnapApp = getDesktopApp("onesnap");
const tubeNitroApp = getDesktopApp("tube-nitro");
const newPortalApp = getDesktopApp("new-portal");
const socialApp = getDesktopApp("social");
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ZG OS</title>
    <meta name="description" content="Zhi Jie Gao — Product designer, builder, writer." />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/styles/desktop-os.css" />
  </head>
  <body>
    <main class="desktop-page" data-desktop-wallpaper="custom">
      <div class="desktop-bg" aria-hidden="true">
        <!-- Paper Texture Overlay -->
        <div class="bg-texture"></div>
        
        <!-- Zen Geometric Cat Illustration -->
        <div class="art-illustration">
          <svg class="zen-cat-art" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <!-- Artistic Sun -->
            <circle class="art-sun" cx="110" cy="90" r="55" fill="#e65a4c" />
            
            <!-- Floor Line -->
            <line x1="20" y1="160" x2="180" y2="160" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="2 6" stroke-linecap="round" />
            
            <g class="cat-group">
              <!-- Tail -->
              <path class="art-tail" d="M 145,140 C 190,140 190,70 160,50 C 145,40 135,65 150,75" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
              
              <!-- Body -->
              <path class="art-body" d="M 45,160 C 45,90 155,90 155,160 Z" fill="var(--bg-canvas)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
              
              <!-- Head -->
              <circle class="art-head" cx="100" cy="80" r="26" fill="var(--bg-canvas)" stroke="var(--ink)" stroke-width="3" />
              
              <!-- Ears -->
              <path class="art-ear" d="M 83,63 L 75,25 L 98,54 Z" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round" />
              <path class="art-ear" d="M 102,54 L 125,25 L 117,63 Z" fill="var(--ink)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round" />
              
              <!-- Face (Zen closed eyes) -->
              <g class="art-face">
                <path d="M 88,85 Q 93,92 98,85" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
                <path d="M 106,85 Q 111,92 116,85" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
                <circle cx="102" cy="95" r="2" fill="var(--ink)" />
              </g>
            </g>
            
            <!-- Minimalist decorative elements -->
            <path class="art-deco" d="M 30,40 L 40,30 M 30,30 L 40,40" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" />
            <circle class="art-deco-dot" cx="170" cy="30" r="3" fill="var(--ink)" />
          </svg>
        </div>

        <!-- Editorial Elements -->
        <div class="editorial-line"></div>
        <div class="editorial-mark">fig. 03 &mdash; geometry</div>
      </div>

      <header class="system-bar">
        <div class="system-left">
          <div class="os-logo" aria-hidden="true"></div>
          <span>ZG OS</span>
        </div>
        <div class="system-right">
          <div class="system-locale" aria-label="Blog language switch">
            {BLOG_LOCALES.map((locale, index) => (
              <button
                class:list={[index === 0 && "is-active"]}
                type="button"
                data-blog-locale-switch={locale}
              >
                {BLOG_LANGUAGE_LABELS[locale]}
              </button>
            ))}
          </div>
          <span>Memory 32%</span>
          <span>Network Link</span>
          <span>Focus Mode</span>
          <time id="clock">--:--</time>
        </div>
      </header>

      <section class="desktop-stage" data-desktop-stage>
        <div class="desktop-widget">
          <div class="widget-time" data-widget-time>--:--</div>
          <div class="widget-date" data-widget-date>Loading date</div>
        </div>

        <DesktopIcons apps={desktopApps} />

        <div class="desktop-window-layer">
          <WindowFrame app={studioApp} title="Studio" open={true} zIndex={12}>
            <StudioWindow />
          </WindowFrame>

          <WindowFrame app={blogApp} title="Archive & Editor" zIndex={14}>
            <DesktopBlogWindow postsByLocale={blogPostsByLocale} defaultHref={defaultBlogHref} />
          </WindowFrame>

          <WindowFrame app={readEasyApp} title="Read Easy">
            <ReadEasyWindow />
          </WindowFrame>

          <WindowFrame app={vibaryApp} title="Vibary">
            <VibaryWindow />
          </WindowFrame>

          <WindowFrame app={settingsApp} title="Settings">
            <SettingsWindow />
          </WindowFrame>

          <WindowFrame app={attenApp} title="Atten">
            <ProductPlaceholderWindow name="Atten" />
          </WindowFrame>

          <WindowFrame app={interludeApp} title="Interlude">
            <ProductPlaceholderWindow name="Interlude" />
          </WindowFrame>

          <WindowFrame app={moldayApp} title="Molday">
            <ProductPlaceholderWindow name="Molday" />
          </WindowFrame>

          <WindowFrame app={onesnapApp} title="OneSnap">
            <ProductPlaceholderWindow name="OneSnap" />
          </WindowFrame>

          <WindowFrame app={tubeNitroApp} title="TubeNitro">
            <ProductPlaceholderWindow name="TubeNitro" />
          </WindowFrame>

          <WindowFrame app={newPortalApp} title="New Portal">
            <ProductPlaceholderWindow name="New Portal" />
          </WindowFrame>

          <WindowFrame app={socialApp} title="Social" variant="group">
            <SocialFolderWindow />
          </WindowFrame>
        </div>

        <DesktopDock apps={desktopApps} />
      </section>
    </main>

    <script type="module" src="/scripts/desktop-os.js"></script>
  </body>
</html>
